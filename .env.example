# Verdant Signal — copy to .env (gitignored) and fill in. All optional: with none set,
# the game runs on the embedded offline crew + procedural text.

# --- Durable memory: CockroachDB ---------------------------------------------
# Apply db/001_agent_memories.sql, then paste the cluster's TLS connection URL.
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
# Keep local testing free until an embedding provider is configured.
MEMORY_EMBEDDINGS_OFF=1
# MEMORY_DB_POOL_SIZE=5

# Optional AWS Bedrock Titan embeddings; vectors remain stored/searched in CockroachDB.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEMORY_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- Expressive LLM channels (chat / DM / conscience) ------------------------
# Any OpenAI-compatible endpoint. Leave OPENAI_BASE_URL unset to use OpenAI;
# point it at a local server (e.g. Ollama) for a fully self-contained stack.
OPENAI_API_KEY=sk-your_key_here               # blank is fine for most local servers
# OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
# RY_FARMS_LLM_MODEL=gpt-4.1-mini             # or a local model id (e.g. gpt-oss:20b)
